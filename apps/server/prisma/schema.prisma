// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    // Include cross-compiled query engines so release artifacts can run on all published server targets.
    binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "darwin", "darwin-arm64", "windows"]
    previewFeatures = ["metrics", "relationJoins"]
}

generator json {
    provider = "prisma-json-types-generator"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//
// Account
//

model Account {
    id              String      @id @default(cuid())
    publicKey       String?     @unique
    /// X25519 (NaCl box) public key for encrypting session DEKs to this account
    contentPublicKey Bytes?
    /// Ed25519 signature binding contentPublicKey to publicKey
    contentPublicKeySig Bytes?
    seq             Int         @default(0)
    /// Minimum cursor a client must have for `/v2/changes?after=...` to be considered reliable.
    /// When we prune orphaned AccountChange rows (e.g. for deleted sessions), we bump this floor so
    /// very old clients are forced to do a snapshot rebuild instead of missing deletion signals.
    changesFloor     Int        @default(0)
    feedSeq         BigInt      @default(0)
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt
    settings        String?
    settingsVersion Int         @default(0)
    encryptionMode  String      @default("e2ee")
    encryptionModeUpdatedAt DateTime @default(now())

    // Profile
    firstName String?
    lastName  String?
    username  String? @unique
    /// [ImageRef]
    avatar    Json?

    Session                Session[]
    SessionSystemRecord    SessionSystemRecord[]
    AccountPushToken       AccountPushToken[]
    VoiceSessionLease      VoiceSessionLease[]
    VoiceConversation      VoiceConversation[]
    TerminalAuthRequest    TerminalAuthRequest[]
    AccountAuthRequest     AccountAuthRequest[]
    AuthPairingSession     AuthPairingSession[]
    UsageReport            UsageReport[]
    Machine                Machine[]
    UploadedFile           UploadedFile[]
    AccountPetPackage      AccountPetPackage[]
    AccountPetAsset        AccountPetAsset[]
    ServiceAccountToken    ServiceAccountToken[]
    ServiceAccountQuotaSnapshot ServiceAccountQuotaSnapshot[]
    ConnectedServiceAuthGroup ConnectedServiceAuthGroup[]
    RelationshipsFrom      UserRelationship[]         @relation("RelationshipsFrom")
    RelationshipsTo        UserRelationship[]         @relation("RelationshipsTo")
    Artifact               Artifact[]
    AccessKey              AccessKey[]
    UserFeedItem           UserFeedItem[]
    UserKVStore            UserKVStore[]
    SharedBySessions       SessionShare[]             @relation("SharedBySessions")
    SharedWithSessions     SessionShare[]             @relation("SharedWithSessions")
    SessionShareAccessLogs SessionShareAccessLog[]    @relation("SessionShareAccessLogs")
    PublicSessionShares    PublicSessionShare[]       @relation("PublicSessionShares")
    PublicShareAccessLogs  PublicShareAccessLog[]     @relation("PublicShareAccessLogs")
    PublicShareBlockedUsers PublicShareBlockedUser[]  @relation("PublicShareBlockedUsers")
    AccountChanges         AccountChange[]
    AccountSettingsSnapshots AccountSettingsSnapshot[]
    SessionPendingMessage  SessionPendingMessage[]
    SessionFolderAssignment SessionFolderAssignment[]
    AccountIdentity        AccountIdentity[]
    automations            Automation[]
    automationRuns         AutomationRun[]
    repositoryConnections  RepositoryConnection[]
    externalIssueRefs      ExternalIssueRef[]
    issueExecutionProjections IssueExecutionProjection[]
    sessionIssueLinks      SessionIssueLink[]
    sessionRuns            SessionRun[]
    sessionRunEvents       SessionRunEvent[]
    providerActionRequests ProviderActionRequest[]
    providerEventReceipts  ProviderEventReceipt[]
    verificationPolicies   VerificationPolicy[]
    externalIssueSyncCursors ExternalIssueSyncCursor[]
    verificationAttempts   VerificationAttempt[]
    verificationProjections VerificationProjection[]
    mergeabilityProjections MergeabilityProjection[]
}

model AccountSettingsSnapshot {
    id              String   @id @default(cuid())
    accountId       String
    version         Int
    settingsDbValue String?
    encryptionMode  String
    contentKind     String
    createdAt       DateTime @default(now())

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@unique([accountId, version])
    @@index([accountId, version])
    @@index([createdAt])
}

enum AccountIdentityEligibilityStatus {
    unknown
    eligible
    ineligible
}

model AccountIdentity {
    id             String   @id @default(cuid())
    accountId      String
    account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

    provider       String
    providerUserId String
    providerLogin  String?
    profile        Json?
    token          Bytes?
    scopes         String?
    showOnProfile  Boolean  @default(true)

    eligibilityStatus      AccountIdentityEligibilityStatus @default(unknown)
    eligibilityReason      String?
    eligibilityCheckedAt   DateTime?
    eligibilityNextCheckAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([provider, providerUserId])
    @@unique([accountId, provider])
    @@index([accountId])
}

model VoiceSessionLease {
    id               String   @id @default(cuid())
    accountId        String
    account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    conversation     VoiceConversation?

    /// Optional Happier sessionId (used only for correlation/telemetry).
    sessionId        String?

    /// UTC YYYY-MM (e.g. "2026-02") for monthly free-quota accounting.
    periodKey        String

    /// "subscription" | "free" (string for forward/backward compatibility).
    grantedBy        String

    /// The ElevenLabs agent id used for minting.
    elevenLabsAgentId String

    expiresAt        DateTime
    createdAt        DateTime @default(now())

    @@index([accountId, expiresAt])
    @@index([accountId, periodKey])
    @@index([expiresAt])
}

model VoiceConversation {
    id                    String   @id @default(cuid())
    accountId             String
    account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

    /// Lifecycle: persisted on completion only (durationSeconds is required).
    /// Optional lease reference (leases may be pruned; conversations should remain).
    leaseId               String?  @unique
    lease                 VoiceSessionLease? @relation(fields: [leaseId], references: [id], onDelete: SetNull)

    /// Provider id, e.g. "elevenlabs_agents".
    providerId            String

    /// Provider-specific conversation id.
    providerConversationId String

    startedAt             DateTime?
    endedAt               DateTime?
    durationSeconds       Int

    /// Optional normalized billing unit count (provider-specific).
    billedUnits           Int?

    createdAt             DateTime @default(now())

    @@unique([providerId, providerConversationId])
    @@index([accountId, createdAt])
    @@index([accountId, providerId, createdAt])
}

model AccountChange {
    accountId String
    kind      String
    entityId  String

    /// Account-scoped monotonic cursor (from Account.seq).
    /// Each row update should get a unique new cursor value for pagination safety.
    cursor    Int
    changedAt DateTime @default(now())
    hint      Json?

    /// Nullable, entity-specific foreign keys used to detect orphaned changes in a database-portable way.
    /// When the target entity is deleted, these are set to NULL via ON DELETE SET NULL.
    sessionId  String?
    machineId  String?
    artifactId String?
    accountPetPackageId String?

    session  Session?  @relation("AccountChangeSession", fields: [sessionId], references: [id], onDelete: SetNull)
    machine  Machine?  @relation("AccountChangeMachine", fields: [machineId], references: [id], onDelete: SetNull)
    artifact Artifact? @relation("AccountChangeArtifact", fields: [artifactId], references: [id], onDelete: SetNull)
    accountPetPackage AccountPetPackage? @relation("AccountChangeAccountPetPackage", fields: [accountPetPackageId], references: [id], onDelete: SetNull)

    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@id([accountId, kind, entityId])
    @@index([accountId, cursor])
    @@index([changedAt(sort: Asc), accountId, cursor])
}

model TerminalAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    supportsV2        Boolean  @default(false)
    claimSecretHash   String?
    claimedAt         DateTime?
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([updatedAt])
}

model AccountAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([updatedAt])
}

model AuthPairingSession {
    id                 String   @id @default(cuid())
    accountId           String
    account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    secretHash          String
    requestedPublicKey  String?
    requestedDeviceLabel String?
    requestedAt         DateTime?
    expiresAt           DateTime
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@index([accountId, expiresAt])
    @@index([expiresAt])
}

model AccountPushToken {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    token     String
    clientServerUrl String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, token])
}

//
// Sessions
//

model Session {
    id                String              @id @default(cuid())
    tag               String
    accountId         String
    account           Account             @relation(fields: [accountId], references: [id])
    encryptionMode    String              @default("e2ee")
    metadata          String
    metadataVersion   Int                 @default(0)
    agentState        String?
    agentStateVersion Int                 @default(0)
    dataEncryptionKey Bytes?
    seq               Int                 @default(0)
    pendingVersion    Int                 @default(0)
    pendingCount      Int                 @default(0)
    pendingQueueSeq   Int                 @default(0)
    // Server-readable per-session activity projection (minimal, E2EE-safe).
    // These fields exist to support authoritative badge counts for background/closed devices.
    lastViewedSessionSeq            Int?
    pendingPermissionRequestCount   Int                 @default(0)
    pendingUserActionRequestCount   Int                 @default(0)
    pendingRequestObservedAt        DateTime?
    latestReadyEventSeq             Int?
    latestReadyEventAt              DateTime?
    thinking                        Boolean             @default(false)
    thinkingAt                      DateTime?
    latestTurnId String?
    latestTurnStatus String?
    latestTurnStatusObservedAt BigInt?
    lastRuntimeIssue String?
    meaningfulActivityAt DateTime?
    active            Boolean             @default(true)
    archivedAt        DateTime?
    lastActiveAt      DateTime            @default(now())
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt
    messages          SessionMessage[]
    turns             SessionTurn[]
    turnMutationReceipts SessionTurnMutationReceipt[]
    systemRecords     SessionSystemRecord[]
    pendingMessages   SessionPendingMessage[]
    usageReports      UsageReport[]
    accessKeys        AccessKey[]
    shares            SessionShare[]
    publicShare       PublicSessionShare?
    accountChanges    AccountChange[]    @relation("AccountChangeSession")
    sessionFolderAssignments SessionFolderAssignment[]
    producedByAutomationRuns AutomationRun[] @relation("AutomationRunProducedSession")
    issueLinks         SessionIssueLink[]
    issueRuns          SessionRun[]
    activeIssueExecutionProjections IssueExecutionProjection[] @relation("IssueExecutionProjectionActivePrimarySession")

    @@unique([accountId, tag])
    @@index([accountId, updatedAt(sort: Desc)])
    @@index([accountId, meaningfulActivityAt(sort: Desc), id(sort: Desc)])
    @@index([accountId, archivedAt(sort: Desc)])
    @@index([lastActiveAt(sort: Asc), updatedAt(sort: Asc)])
}

model SessionTurn {
    id                      String   @id @default(cuid())
    sessionId               String
    session                 Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    turnId                  String
    provider                String?
    providerTurnId          String?
    status                  String
    startedAt               BigInt
    updatedAt               BigInt
    terminalAt              BigInt?
    lastRuntimeIssueJson    String?
    transcriptAnchorsJson   String?
    rollbackState           String?
    rollbackReason          String?
    providerRollbackOrdinal Int?
    rollbackUpdatedAt       BigInt?
    lastMutationId          String?
    createdAt               DateTime @default(now())

    @@unique([sessionId, turnId])
    @@index([sessionId, updatedAt])
    @@index([sessionId, status])
    @@index([sessionId, rollbackState])
    @@index([sessionId, provider, providerTurnId])
}

model SessionTurnMutationReceipt {
    id         String   @id @default(cuid())
    sessionId  String
    session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    mutationId String
    turnId     String?
    action     String
    decision   String
    observedAt BigInt
    appliedAt  BigInt
    createdAt  DateTime @default(now())

    @@unique([sessionId, mutationId])
    @@index([sessionId, appliedAt])
}

model SessionFolderAssignment {
    id        String   @id @default(cuid())
    accountId String
    sessionId String
    folderId  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@unique([accountId, sessionId])
    @@index([accountId, folderId, updatedAt])
    @@index([sessionId])
}

model SessionMessage {
    id        String   @id @default(cuid())
    sessionId String
    session   Session  @relation(fields: [sessionId], references: [id])
    localId   String?
    sidechainId String?
    seq       Int
    messageRole String?
    /// [SessionMessageContent]
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // `localId` is a session-global idempotency key (unique across sidechains within a session).
    @@unique([sessionId, localId])
    @@index([sessionId, seq])
    @@index([sessionId, sidechainId, seq])
    @@index([sessionId, messageRole, seq])
    @@index([sessionId, sidechainId, messageRole, seq])
}

enum SessionPendingMessageStatus {
    queued
    discarded
}

model SessionPendingMessage {
    id              String                     @id @default(cuid())
    sessionId        String
    session          Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    /// Informational only (attribution); pending queue is session-global.
    authorAccountId  String?
    authorAccount    Account?                   @relation(fields: [authorAccountId], references: [id], onDelete: SetNull)

    localId          String
    messageRole      String?
    /// [SessionPendingMessageContent]
    content          Json
    status           SessionPendingMessageStatus @default(queued)
    position         Int
    discardedAt      DateTime?
    discardedReason  String?
    createdAt        DateTime                   @default(now())
    updatedAt        DateTime                   @updatedAt

    @@unique([sessionId, localId])
    @@index([sessionId, status, position])
    @@index([sessionId, authorAccountId])
    @@index([sessionId, status, updatedAt])
}

model SessionSystemRecord {
    id        String   @id @default(cuid())
    accountId String
    sessionId String
    namespace String
    kind      String
    localId   String
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@unique([accountId, sessionId, namespace, localId], map: "SSR_account_session_namespace_local_key")
    @@index([accountId, sessionId, namespace, kind, updatedAt(sort: Desc), id(sort: Desc)], map: "SSR_account_session_namespace_kind_updated_id_idx")
    @@index([sessionId, namespace, kind, updatedAt(sort: Desc), id(sort: Desc)], map: "SSR_session_namespace_kind_updated_id_idx")
}

model GithubOrganization {
    id        String   @id
    /// [GitHubOrg]
    profile   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Utility
//

model GlobalLock {
    key       String   @id @default(cuid())
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    expiresAt DateTime

    @@index([expiresAt])
}

model RepeatKey {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    expiresAt DateTime

    @@index([expiresAt])
}

model SimpleCache {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Usage Reporting
//

model UsageReport {
    id        String   @id @default(cuid())
    key       String
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    sessionId String?
    session   Session? @relation(fields: [sessionId], references: [id])
    /// [UsageReportData]
    data      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, sessionId, key])
    @@index([accountId])
    @@index([sessionId])
}

//
// Machines
//

model Machine {
    id                 String      @id
    accountId          String
    account            Account     @relation(fields: [accountId], references: [id])
    metadata           String // Encrypted - contains static machine info
    metadataVersion    Int         @default(0)
    daemonState        String? // Encrypted - contains dynamic daemon state
    daemonStateVersion Int         @default(0)
    dataEncryptionKey  Bytes?
    installationId     String?
    installationPublicKey Bytes?
    contentPublicKeyFingerprint String?
    replacedByMachineId String?
    replacedAt         DateTime?
    replacementReason  String?
    replacementSource  String?
    replacementActorUserId String?
    seq                Int         @default(0)
    active             Boolean     @default(true)
    lastActiveAt       DateTime    @default(now())
    revokedAt          DateTime?
    createdAt          DateTime    @default(now())
    updatedAt          DateTime    @updatedAt
    accessKeys         AccessKey[]
    accountChanges     AccountChange[] @relation("AccountChangeMachine")
    automationAssignments AutomationAssignment[]
    automationClaimedRuns AutomationRun[] @relation("AutomationRunClaimedByMachine")
    pollerRepositoryConnections RepositoryConnection[] @relation("RepositoryConnectionPollingOwnerMachine")
    claimedIssueRuns   SessionRun[] @relation("SessionRunClaimedByMachine")
    targetedProviderActions ProviderActionRequest[] @relation("ProviderActionTargetMachine")

    @@unique([accountId, id])
    @@index([accountId])
    @@index([accountId, installationId])
    @@index([accountId, replacedByMachineId])
    @@index([accountId, replacedAt(sort: Desc)])
    @@index([accountId, revokedAt(sort: Desc)])
}

enum RepositoryProviderKind {
    github
    gitlab
}

enum RepositoryConnectionMode {
    quickstart
    managed
}

enum RepositoryAuthKind {
    github_app
    gitlab_token
    gh_cli
    glab_cli
    user_pat
}

enum SessionIssueRelation {
    primary
    context
}

enum SessionRunState {
    queued
    claimed
    running
    waiting_user
    succeeded
    failed
    cancelled
    expired
}

enum ProviderActionKind {
    comment
    label_sync
    assignee_sync
    issue_link_back
    open_change
    update_change
    close_issue
}

enum VerificationSource {
    remote_ci
    local_runtime
    manual_override
}

enum VerificationLifecycleState {
    queued
    running
    completed
    failed
    cancelled
    timed_out
}

enum VerificationConclusion {
    passed
    failed
    pending
    skipped
    neutral
    action_required
    unknown
}

enum VerificationProjectionHeadline {
    verified_remote
    verified_local_only
    partially_verified
    unverified
    verification_failed
    verification_pending
}

enum VerificationBlockingState {
    clear
    warning
    blocked
}

enum ProviderActionExecutionMode {
    server_worker
    machine_runtime
}

enum ProviderActionState {
    queued
    claimed
    running
    succeeded
    failed
    cancelled
    expired
}

enum IssueWorkflowState {
    idle
    executing
    change_open
    awaiting_review
    done
}

enum MergeabilityState {
    mergeable
    blocked_required_checks
    blocked_reviews
    blocked_conflicts
    draft
    unknown
}

model RepositoryConnection {
    id                    String                   @id @default(cuid())
    accountId             String
    account               Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    provider              RepositoryProviderKind
    providerBaseUrl       String
    repositoryKey         String
    mode                  RepositoryConnectionMode
    authKind              RepositoryAuthKind
    enabled               Boolean                  @default(true)
    webhookEnabled        Boolean                  @default(false)
    remoteCiDetected      Boolean                  @default(false)
    pollerEnabled         Boolean                  @default(false)
    pollingOwnerMachineId String?
    pollingOwnerMachine   Machine?                 @relation("RepositoryConnectionPollingOwnerMachine", fields: [pollingOwnerMachineId], references: [id], onDelete: SetNull)
    pollingLeaseExpiresAt DateTime?
    degradedReason        String?
    capabilities          Json?
    installedAt           DateTime?
    lastCapabilitySyncAt  DateTime?
    createdAt             DateTime                 @default(now())
    updatedAt             DateTime                 @updatedAt
    issueRefs             ExternalIssueRef[]
    sessionRuns           SessionRun[]
    providerActions       ProviderActionRequest[]
    eventReceipts         ProviderEventReceipt[]
    verificationPolicies  VerificationPolicy[]
    syncCursors           ExternalIssueSyncCursor[]

    @@unique([accountId, provider, providerBaseUrl, repositoryKey])
    @@index([accountId, enabled, updatedAt(sort: Desc)])
    @@index([accountId, mode, updatedAt(sort: Desc)])
    @@index([pollingOwnerMachineId, pollingLeaseExpiresAt])
}

model ExternalIssueRef {
    id                      String                   @id @default(cuid())
    accountId               String
    account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    repositoryConnectionId  String
    repositoryConnection    RepositoryConnection     @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
    provider                RepositoryProviderKind
    providerBaseUrl         String
    repositoryKey           String
    providerIssueExternalId String?
    issueNumber             Int
    title                   String
    state                   String
    labels                  Json?
    assignees               Json?
    url                     String
    lastEventKey            String?
    lastEventAt             DateTime?
    rawSnapshot             Json?
    syncedAt                DateTime
    createdAt               DateTime                 @default(now())
    updatedAt               DateTime                 @updatedAt
    sessionLinks            SessionIssueLink[]
    sessionRuns             SessionRun[]
    executionProjection     IssueExecutionProjection?
    providerActions         ProviderActionRequest[]
    providerEventReceipts   ProviderEventReceipt[]

    @@unique([accountId, provider, providerBaseUrl, repositoryKey, issueNumber])
    @@index([repositoryConnectionId, issueNumber])
    @@index([accountId, state, syncedAt(sort: Desc)])
    @@index([accountId, repositoryKey, updatedAt(sort: Desc)])
}

model SessionIssueLink {
    id                 String               @id @default(cuid())
    accountId          String
    account            Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
    sessionId          String
    session            Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    externalIssueRefId String
    externalIssueRef   ExternalIssueRef     @relation(fields: [externalIssueRefId], references: [id], onDelete: Cascade)
    relation           SessionIssueRelation
    active             Boolean              @default(true)
    resolutionReason   String?
    createdBy          String?
    createdAt          DateTime             @default(now())
    updatedAt          DateTime             @updatedAt
    deactivatedAt      DateTime?

    @@index([externalIssueRefId, relation, active])
    @@index([sessionId, relation, active])
    @@index([sessionId, externalIssueRefId, relation, active])
    @@index([accountId, createdAt(sort: Desc)])
}

model SessionRun {
    id                       String                @id @default(cuid())
    accountId                String
    account                  Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
    repositoryConnectionId   String
    repositoryConnection     RepositoryConnection  @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
    sessionId                String
    session                  Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    externalIssueRefId       String
    externalIssueRef         ExternalIssueRef      @relation(fields: [externalIssueRefId], references: [id], onDelete: Cascade)
    state                    SessionRunState       @default(queued)
    triggerKind              String
    scheduledAt              DateTime              @default(now())
    dueAt                    DateTime?
    claimedAt                DateTime?
    startedAt                DateTime?
    finishedAt               DateTime?
    claimedByMachineId       String?
    claimedByMachine         Machine?              @relation("SessionRunClaimedByMachine", fields: [claimedByMachineId], references: [id], onDelete: SetNull)
    leaseExpiresAt           DateTime?
    attempt                  Int                   @default(0)
    idempotencyKey           String
    generation               Int                   @default(0)
    branchName               String?
    providerChangeUrl        String?
    providerChangeNumber     Int?
    providerChangeExternalId String?
    headCommitSha            String?
    baseCommitSha            String?
    summaryCiphertext        String?
    errorCode                String?
    errorMessage             String?
    retryOfRunId             String?
    retryOfRun               SessionRun?           @relation("SessionRunRetryChain", fields: [retryOfRunId], references: [id], onDelete: SetNull)
    retryChildren            SessionRun[]          @relation("SessionRunRetryChain")
    createdAt                DateTime              @default(now())
    updatedAt                DateTime              @updatedAt
    events                   SessionRunEvent[]
    providerActions          ProviderActionRequest[]
    activeIssueExecutionProjections IssueExecutionProjection[] @relation("IssueExecutionProjectionActivePrimaryRun")
    verificationAttempts     VerificationAttempt[]
    verificationProjection   VerificationProjection?
    mergeabilityProjection   MergeabilityProjection?

    @@unique([accountId, idempotencyKey])
    @@index([accountId, state, scheduledAt(sort: Desc)])
    @@index([sessionId, createdAt(sort: Desc)])
    @@index([externalIssueRefId, createdAt(sort: Desc)])
    @@index([claimedByMachineId, leaseExpiresAt])
    @@index([providerChangeExternalId, headCommitSha])
}

model IssueExecutionProjection {
    id                          String              @id @default(cuid())
    accountId                   String
    account                     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
    externalIssueRefId          String              @unique
    externalIssueRef            ExternalIssueRef    @relation(fields: [externalIssueRefId], references: [id], onDelete: Cascade)
    workflowState               IssueWorkflowState
    activePrimarySessionId      String?
