# Graphify already hard-skips common dependency/build/cache folders such as
# node_modules, dist, build, out, .git, .next, .turbo, coverage, snapshots,
# graphify-out, and .worktrees. Keep this file focused on repo-specific noise.

# Package manager and build outputs not covered by Graphify defaults
/.yarn-cache/
/.yarn-global/
/web-build/
/apps/server/output/
/apps/cli/.dist.hstack-backup/
/apps/stack/output/

# Native/generated app artifacts
/ios/
/android/
/apps/ui/ios/
/apps/ui/android/
/.expo/
/.gradle/
/.kotlin/

# Local tool/runtime state
/.happier/
/.claude/cache/
/.project/
/.edison/_generated/
/.edison/_locks/
/.edison/session/
/.argent/
/.codex-tmp/
/.playwright-mcp/
/.tmp-home/
/.tmp/
/tmp/

# Test artifacts and large test-only corpora
playwright-report/
test-results/
*.snap
*.test.*
*.spec.*
/packages/tests/

# Local reports, screenshots, and scratch output
*.log
*.png
*.jpg
*.jpeg
*.webp
*_SUMMARY.md
*_ANALYSIS.md
/output/
